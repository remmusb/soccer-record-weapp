
.container.data-v-d04f8779 {
  padding: 20rpx;
  padding-bottom: 40rpx;
}
.card.data-v-d04f8779 {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.form-row.data-v-d04f8779 {
  display: flex;
}
.form-group.data-v-d04f8779 {
  margin-bottom: 24rpx;
}
.form-label.data-v-d04f8779 {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
  display: block;
}
.form-input.data-v-d04f8779 {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}
.form-textarea.data-v-d04f8779 {
  width: 100%;
  padding: 16rpx 24rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  min-height: 160rpx;
}
.picker.data-v-d04f8779 {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #374151;
}
.picker-placeholder.data-v-d04f8779 {
  color: #9ca3af;
}
.switch-row.data-v-d04f8779 {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #374151;
}
.deadline-display.data-v-d04f8779 {
  font-size: 28rpx;
  color: #374151;
  padding: 20rpx 24rpx;
  background: #f9fafb;
  border-radius: 12rpx;
}
.submit-bar.data-v-d04f8779 {
  padding: 20rpx 0;
}
.btn-primary.data-v-d04f8779 {
  background: #16a34a;
  color: #fff;
  border-radius: 16rpx;
  padding: 28rpx 0;
  text-align: center;
  font-weight: 600;
  font-size: 32rpx;
}
.btn-primary.data-v-d04f8779:active {
  opacity: 0.9;
}
.hint-text.data-v-d04f8779 {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 8rpx;
  display: block;
}
.location-row.data-v-d04f8779 {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.location-input.data-v-d04f8779 {
  flex: 1;
}
.btn-map.data-v-d04f8779 {
  background: #3b82f6;
  color: #fff;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  white-space: nowrap;
  flex-shrink: 0;
}
.deadline-row.data-v-d04f8779 {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.deadline-row .deadline-display.data-v-d04f8779 {
  flex: 1;
}
.btn-edit.data-v-d04f8779 {
  background: #f3f4f6;
  color: #374151;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  white-space: nowrap;
  flex-shrink: 0;
}
.btn-row.data-v-d04f8779 {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}
.btn-confirm.data-v-d04f8779, .btn-reset.data-v-d04f8779 {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.btn-confirm.data-v-d04f8779 {
  background: #16a34a;
  color: #fff;
}
.btn-reset.data-v-d04f8779 {
  background: #f3f4f6;
  color: #374151;
}

/* 场主和护法 */
.assistants-tags.data-v-d04f8779 {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.assistant-tag.data-v-d04f8779 {
  background: #e0e7ff;
  color: #4338ca;
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.tag-remove.data-v-d04f8779 {
  color: #dc2626;
  font-weight: 700;
  margin-left: 8rpx;
}
.btn-add-assistant.data-v-d04f8779 {
  background: #f0fdf4;
  color: #16a34a;
  border: 2rpx solid #bbf7d0;
  border-radius: 12rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}
