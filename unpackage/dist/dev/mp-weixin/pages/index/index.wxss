
.container.data-v-1cf27b2a {
  padding: 20rpx;
  padding-bottom: 40rpx;
  background: linear-gradient(180deg, #f0f5ff 0%, #f5f7fa 30%, #f5f7fa 100%);
  min-height: 100vh;
}
.create-bar.data-v-1cf27b2a {
  margin-bottom: 24rpx;
}
.icon.data-v-1cf27b2a {
  margin-right: 8rpx;
  font-size: 36rpx;
}
.section.data-v-1cf27b2a {
  margin-bottom: 24rpx;
}
.section-title.data-v-1cf27b2a {
  font-size: 28rpx;
  font-weight: 800;
  color: #475569;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.match-card.data-v-1cf27b2a {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  position: relative;
  overflow: hidden;
}
.match-card.data-v-1cf27b2a::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4rpx;
}
.match-card.orange.data-v-1cf27b2a::before {
  background: linear-gradient(90deg, #f97316, #fb923c);
}
.match-card.blue.data-v-1cf27b2a::before {
  background: linear-gradient(90deg, #3b82f6, #60a5fa);
}
.match-card.gray.data-v-1cf27b2a::before {
  background: linear-gradient(90deg, #94a3b8, #cbd5e1);
}
.match-card.orange.data-v-1cf27b2a {
  background: linear-gradient(135deg, #ffffff, #fff7ed);
}
.match-card.blue.data-v-1cf27b2a {
  background: linear-gradient(135deg, #ffffff, #eff6ff);
}
.match-card.gray.data-v-1cf27b2a {
  background: linear-gradient(135deg, #ffffff, #f8fafc);
}
.match-header.data-v-1cf27b2a {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.match-title.data-v-1cf27b2a {
  font-size: 34rpx;
  font-weight: 800;
  color: #1e293b;
  margin-bottom: 8rpx;
}
.match-info.data-v-1cf27b2a {
  font-size: 26rpx;
  color: #64748b;
  margin-top: 4rpx;
  font-weight: 500;
}
.match-deadline.data-v-1cf27b2a {
  font-size: 24rpx;
  color: #f97316;
  margin-top: 8rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.match-owner.data-v-1cf27b2a {
  margin-top: 10rpx;
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}
.match-right.data-v-1cf27b2a {
  text-align: right;
  flex-shrink: 0;
  margin-left: 20rpx;
}
.match-score.data-v-1cf27b2a {
  font-size: 48rpx;
  font-weight: 800;
  color: #16a34a;
  margin-bottom: 8rpx;
}
.match-result.data-v-1cf27b2a {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #f8fafc, #f0f9ff);
  border-radius: 16rpx;
  gap: 12rpx;
}
.team-side.data-v-1cf27b2a {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}
.team.data-v-1cf27b2a {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 100%;
}
.team-a.data-v-1cf27b2a { justify-content: flex-start;
}
.team-b.data-v-1cf27b2a { justify-content: flex-end;
}
.team-dot.data-v-1cf27b2a {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 3rpx solid #fff;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.15);
}
.team-name.data-v-1cf27b2a {
  font-size: 28rpx;
  font-weight: 700;
  color: #374151;
}
.team-score.data-v-1cf27b2a {
  font-size: 44rpx;
  font-weight: 900;
  color: #1e293b;
}
.vs.data-v-1cf27b2a {
  font-size: 28rpx;
  font-weight: 800;
  color: #94a3b8;
  flex-shrink: 0;
  align-self: center;
  padding: 8rpx 12rpx;
  background: #f1f5f9;
  border-radius: 10rpx;
}
.team-goals.data-v-1cf27b2a {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 4rpx;
}
.team-goal-item.data-v-1cf27b2a {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  padding: 8rpx 12rpx;
  background: #fff;
  border-radius: 10rpx;
  flex-wrap: wrap;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.05);
  font-weight: 500;
}
.goal-icon.data-v-1cf27b2a {
  font-size: 22rpx;
  flex-shrink: 0;
}
.goal-player.data-v-1cf27b2a {
  color: #334155;
  font-weight: 600;
  flex-shrink: 0;
}
.goal-assist.data-v-1cf27b2a {
  color: #2563eb;
  background: #eff6ff;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.own-goal-tag.data-v-1cf27b2a {
  color: #dc2626;
  font-size: 22rpx;
  margin-left: 4rpx;
  font-weight: 800;
}
.goal-minute.data-v-1cf27b2a {
  color: #94a3b8;
  font-size: 22rpx;
  margin-left: auto;
  flex-shrink: 0;
  font-weight: 500;
}
.team-color-name.data-v-1cf27b2a {
  font-size: 28rpx;
  font-weight: 700;
  color: #475569;
}
.status-tag.data-v-1cf27b2a {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.status-upcoming.data-v-1cf27b2a {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
  color: #1e40af;
}
.status-ongoing.data-v-1cf27b2a {
  background: linear-gradient(135deg, #ffedd5, #fed7aa);
  color: #9a3412;
}
.status-completed.data-v-1cf27b2a {
  background: linear-gradient(135deg, #dcfce7, #bbf7d0);
  color: #166534;
}
.status-closed.data-v-1cf27b2a {
  background: linear-gradient(135deg, #f1f5f9, #e2e8f0);
  color: #64748b;
}
.status-split.data-v-1cf27b2a {
  background: linear-gradient(135deg, #ede9fe, #ddd6fe);
  color: #5b21b6;
}
.status-rating.data-v-1cf27b2a {
  background: linear-gradient(135deg, #dcfce7, #bbf7d0);
  color: #16a34a;
}
.new-badge.data-v-1cf27b2a {
  display: inline-flex;
  align-items: center;
  background: linear-gradient(135deg, #dc2626, #ef4444);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-left: 8rpx;
  font-weight: 700;
  line-height: 1;
  vertical-align: middle;
}
.empty.data-v-1cf27b2a {
  text-align: center;
  padding: 120rpx 40rpx;
}
.empty-icon.data-v-1cf27b2a {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.empty-text.data-v-1cf27b2a {
  font-size: 28rpx;
  color: #94a3b8;
}

/* 标签样式 */
.tag.data-v-1cf27b2a { display: inline-flex; align-items: center; padding: 4rpx 10rpx; border-radius: 8rpx; font-size: 20rpx; font-weight: 600;
}
.tag-yellow.data-v-1cf27b2a { background: #fef3c7; color: #92400e;
}
.tag-purple.data-v-1cf27b2a { background: #ede9fe; color: #5b21b6;
}

/* 创建按钮 */
.btn-primary.data-v-1cf27b2a { background: linear-gradient(135deg, #16a34a, #22c55e); color: #fff; text-align: center; padding: 26rpx 0; border-radius: 14rpx; font-size: 32rpx; font-weight: 700; box-shadow: 0 4rpx 12rpx rgba(22,163,74,0.3);
}

/* MVP 展示 */
.match-mvp.data-v-1cf27b2a { display: flex; align-items: center; gap: 8rpx; margin-top: 16rpx; padding: 10rpx 16rpx; background: linear-gradient(135deg, #fefce8, #fef9c3); border-radius: 10rpx;
}
.mvp-label.data-v-1cf27b2a { font-size: 24rpx; font-weight: 800; color: #eab308; flex-shrink: 0;
}
.mvp-name.data-v-1cf27b2a { font-size: 26rpx; font-weight: 700; color: #854d0e;
}
